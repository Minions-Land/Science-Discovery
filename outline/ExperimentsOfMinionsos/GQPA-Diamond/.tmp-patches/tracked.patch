+_FINAL_ANSWER_RE = re.compile(
+    r"FINAL\s+ANSWER\s+([A-Za-z0-9_-]+)\s*[:\-]\s*([A-D])\b",
+    re.IGNORECASE,
+)
+
+
+def _parse_batch_answers(text: str) -> dict[str, str]:
+    """Parse 'FINAL ANSWER <qid>: <letter>' lines from *text*.
+
+    Later lines for the same qid override earlier lines (treat the file as a
+    log; the last claim wins). Letters are upper-cased.
+    """
+    out: dict[str, str] = {}
+    for match in _FINAL_ANSWER_RE.finditer(text):
+        qid = match.group(1)
+        letter = match.group(2).upper()
+        out[qid] = letter
+    return out
+
+
+def _evaluate_answer_grader_batch(
+    port: int, meta: dict, reference_override: str | None
+) -> dict[str, object]:
+    """Compare batched answers.md to reference {qid: letter} dict.
+
+    Reads ``branches/shared/submissions/answers.md``, extracts every
+    ``FINAL ANSWER <qid>: <letter>`` line, compares against
+    ``input/expected.json`` (a flat ``{qid: letter}`` mapping), and reports
+    per-question correctness plus aggregate accuracy.
+    """
+    profile_eval = meta.get("profile_evaluation", {})
+    reference_path_rel = reference_override or profile_eval.get(
+        "reference_path", "input/expected.json"
+    )
+
+    pdir = project_dir(port)
+    reference_path = pdir / reference_path_rel
+    submission_path = project_shared_subdir(port, "submissions") / "answers.md"
+
+    if not reference_path.exists():
+        raise ProjectError(f"Reference answers not found: {reference_path}")
+    if not submission_path.exists():
+        raise ProjectError(f"Submission answers not found: {submission_path}")
+
+    expected_raw = json.loads(reference_path.read_text(encoding="utf-8"))
+    if not isinstance(expected_raw, dict):
+        raise ProjectError(
+            f"answer_grader_batch: expected.json must be a {{qid: letter}} object, "
+            f"got {type(expected_raw).__name__}"
+        )
+    expected: dict[str, str] = {str(k): str(v).strip().upper() for k, v in expected_raw.items()}
+
+    submitted = _parse_batch_answers(submission_path.read_text(encoding="utf-8"))
+
+    per_question: dict[str, dict[str, object]] = {}
+    correct = 0
+    answered = 0
+    for qid, expected_letter in expected.items():
+        submitted_letter = submitted.get(qid)
+        if submitted_letter is None:
+            per_question[qid] = {
+                "expected": expected_letter,
+                "submitted": None,
+                "status": "missing",
+            }
+            continue
+        answered += 1
+        is_correct = submitted_letter == expected_letter
+        if is_correct:
+            correct += 1
+        per_question[qid] = {
+            "expected": expected_letter,
+            "submitted": submitted_letter,
+            "status": "correct" if is_correct else "incorrect",
+        }
+
+    extra = sorted(set(submitted) - set(expected))
+    total = len(expected)
+    accuracy = (correct / total) if total > 0 else 0.0
+    # Verdict 'correct' is reserved for the all-correct case so the on_done
+    # passing-gate logic in mos_evaluate doesn't auto-shutdown a partially
+    # correct batch.
+    if total > 0 and correct == total:
+        verdict = "correct"
+    elif answered < total:
+        verdict = "incomplete"
+    else:
+        verdict = "partial"
+
+    logger.info(
+        "answer_grader_batch: port=%d total=%d answered=%d correct=%d accuracy=%.3f",
+        port,
+        total,
+        answered,
+        correct,
+        accuracy,
+    )
+
+    return {
+        "port": port,
+        "strategy": "answer_grader_batch",
+        "score": accuracy,
+        "verdict": verdict,
+        "details": {
+            "total": total,
+            "answered": answered,
+            "correct": correct,
+            "incorrect": answered - correct,
+            "missing": total - answered,
+            "extra_qids": extra,
+            "per_question": per_question,
+        },
+    }
+
