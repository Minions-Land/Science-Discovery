@@ -479,9 +479,27 @@ def _role_env(
 
 
 def _role_model(cfg: GruConfig, role_name: str) -> str | None:
-    """Return the model override for a role, or None for the default."""
+    """Return the model override for a role, or None for the default.
+
+    Resolution order (first non-empty wins):
+    1. ``MINIONS_<ROLE>_MODEL`` env var (per-role hard override; used by
+       benchmark harnesses to pin a single cell without mutating gru.yaml).
+    2. ``cfg.<role>_model`` from gru.yaml.
+    3. None → launcher omits ``--model`` and Claude CLI picks its default.
+    """
+    import os as _os
+
+    env_key = f"MINIONS_{role_name.upper()}_MODEL"
+    env_value = _os.environ.get(env_key, "").strip()
+    if env_value:
+        return env_value
+
     if role_name == "noter":
         return cfg.noter_model
+    if role_name == "expert" or role_name.startswith("expert-"):
+        return cfg.expert_model
+    if role_name == "coder":
+        return cfg.coder_model
     return None
 
 
